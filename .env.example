# The gateway never reads provider credentials from its config file — the config
# names an environment variable per provider instance and the process resolves it
# at startup. A config file gets committed, pasted into a ticket, and shipped in
# a container image; an env var does not.
#
# None of these are needed to run the tests, the self-checks, or any benchmark in
# the README: every measured number in this project is taken against the local
# mock provider, so the whole suite runs offline with no credentials at all.

# Only required if you point a route at the real OpenAI.
OPENAI_API_KEY=sk-your-key-here

# Only required if you point a route at the real Anthropic.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# The mock provider accepts any key; this is what the example config expects so
# that the auth path is genuinely exercised end to end rather than bypassed.
MOCK_API_KEY=mock-key
