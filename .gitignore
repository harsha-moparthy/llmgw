# Compiled binaries. These patterns are anchored to the repo root with a leading
# slash: bare names would also match the cmd/mockprovider and cmd/gwbench SOURCE
# directories, which silently excluded them from the first commit.
/bin/
/llmgw
/mockprovider
/gwbench

# Go build/test artifacts
*.test
*.out
coverage.*

# Secrets — the gateway reads provider keys from the environment, never from a
# committed file. .env.example documents the variable names.
.env

# Transient logs. results/ is deliberately NOT ignored: the measured numbers in
# the README are reproduced from committed run artifacts, so a reader can check
# them without re-running the benchmarks.
*.log
/tmp/
/run/

# The mock providers' request logs and the gateway ledger are regenerated by
# every benchmark run; the copies that back a reported number live under
# results/. The whole data/ working directory is transient.
/data/

# Scratch test files. Audit/verification passes create these to demonstrate a
# bug and are supposed to delete them; ignoring the pattern means one that
# escapes cleanup cannot be committed by an `git add -A`.
zz_*_test.go

.DS_Store
